# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net)
# When omitted, the dashboard uses a persistent local JSON store in ./data/city-companion-db.json
MONGODB_URI=
MONGODB_DB_NAME=city_companion

# ADMIN_SECRET: API key accepted in X-Admin-Key header or Admin Login
ADMIN_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# APP_BACKEND_URL: City Companion Android app backend URL for instant Socket.IO change notifications
APP_BACKEND_URL=
INTERNAL_SYNC_SECRET=

